# Copy to .env and fill in real values — .env is gitignored, never commit real credentials.
# Existing per-brand test accounts (see .env for the real ones already in use):
#   <BRAND>_TEST_USER_EMAIL / <BRAND>_TEST_USER_PASSWORD

# --- crm-qa-tester agent -----------------------------------------------
#
# Slack DM to send reports + screenshots to. This is the connected Slack
# account's own DM channel — not a secret, just an ID (confirmed working
# 2026-09-16). Safe to leave as-is.
SLACK_DM_CHANNEL_ID=U0B8GN220TZ
#
# Jira, Smartico, the backoffice admin tool, and the test mailbox are all
# reached through `claude-in-chrome` — the operator's own real Chrome,
# already logged in from normal daily use. No passwords for any of these
# live here; only the URLs the agent needs to navigate to.

JIRA_BASE_URL=

# Per-brand backoffice admin tool URL — grants a test deposit/bonus
# directly to a test account, WITHOUT the real payment flow. One per
# brand you want the agent to cover.
FERRAPLAY_BACKOFFICE_URL=

# Test-user mailbox address to read (via claude-in-chrome, so no password
# needed here). If it's a real Gmail address (wiztest+N@gmail.com style)
# make sure the operator is already logged into it in their own Chrome —
# that's what lets the agent skip Google's 2FA/"suspicious sign-in" wall
# entirely.
CRM_TEST_MAILBOX_EMAIL=

# --- shelbyspin-provider-localization.spec.ts --------------------------
#
# Real, registered test account on shelbyspin3322.com (see .env for the
# real value already in use). This brand resolves locale by geo-IP only —
# the whole suite needs a Dutch-IP VPN active for the run's duration.
SHELBYSPIN_TEST_USER_EMAIL=
SHELBYSPIN_TEST_USER_PASSWORD=
